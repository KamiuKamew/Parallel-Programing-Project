CXX = g++
NVCC = nvcc
CXXFLAGS = -std=c++20 -O3 -Wall -Wextra
NVCCFLAGS = -std=c++20 -O3 -arch=sm_75

SRCDIR = src
INCDIR = src/include
TESTDIR = .

INCLUDES = -I$(INCDIR) -I$(INCDIR)/general -I$(INCDIR)/CUDA

# 基础版本
all: main_cpu main_gpu

# 优化版本目标
optimized: main_gpu_optimized

# Stage 1优化版本目标
stage1: main_gpu_stage1

# Stage 2优化版本目标
stage2: main_gpu_stage2

# Stage 3优化版本目标
stage3: main_gpu_stage3

# 性能对比测试目标
performance_comparison: main_performance_comparison

main_cpu: main.cc
	$(CXX) $(CXXFLAGS) $(INCLUDES) -DUSE_CPU_ONLY -o $@ $<

main_gpu: main.cc $(INCDIR)/CUDA/ntt_gpu_lab5_optimized.o
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -o $@ $^

# 优化版本目标
main_gpu_optimized: main_optimized.cc $(INCDIR)/CUDA/ntt_gpu.o
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -o $@ $^

# Stage 1优化版本目标
main_gpu_stage1: main_stage1.cc $(INCDIR)/CUDA/ntt_gpu_stage1_optimized.o
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -o $@ $^

# Stage 2优化版本目标
main_gpu_stage2: main_stage2.cc $(INCDIR)/CUDA/ntt_gpu_stage2_optimized.o
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -o $@ $^

# Stage 3优化版本目标
main_gpu_stage3: main_stage3.cc $(INCDIR)/CUDA/ntt_gpu_stage3_optimized.o
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -o $@ $^

# 性能对比测试目标
main_performance_comparison: main_performance_comparison.cc $(INCDIR)/CUDA/ntt_gpu_lab5_optimized.o $(INCDIR)/CUDA/ntt_gpu_stage1_optimized.o $(INCDIR)/CUDA/ntt_gpu_stage2_optimized.o $(INCDIR)/CUDA/ntt_gpu_stage3_optimized.o
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -o $@ $^

# 基础GPU对象文件
$(INCDIR)/CUDA/ntt_gpu.o: $(INCDIR)/CUDA/ntt_gpu.cu
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -c -o $@ $<

# Lab5优化版本GPU对象文件
$(INCDIR)/CUDA/ntt_gpu_lab5_optimized.o: $(INCDIR)/CUDA/ntt_gpu_lab5_optimized.cu
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -c -o $@ $<

# Stage 1优化版本GPU对象文件
$(INCDIR)/CUDA/ntt_gpu_stage1_optimized.o: $(INCDIR)/CUDA/ntt_gpu_stage1_optimized.cu
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -c -o $@ $<

# Stage 2优化版本GPU对象文件
$(INCDIR)/CUDA/ntt_gpu_stage2_optimized.o: $(INCDIR)/CUDA/ntt_gpu_stage2_optimized.cu
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -c -o $@ $<

# Stage 3优化版本GPU对象文件
$(INCDIR)/CUDA/ntt_gpu_stage3_optimized.o: $(INCDIR)/CUDA/ntt_gpu_stage3_optimized.cu
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -c -o $@ $<

# 测试优化效果
test_performance: test_optimized_performance
	@echo "正在运行Lab5.tex优化策略验证测试..."
	./test_optimized_performance

test_optimized_performance: test_optimized_performance.cu $(INCDIR)/CUDA/ntt_gpu.o
	$(NVCC) $(NVCCFLAGS) $(INCLUDES) -o test_optimized_performance $^

# 对比测试
compare_versions: main_gpu main_gpu_optimized
	@echo "=== 基础版本测试 ==="
	./main_gpu
	@echo ""
	@echo "=== 优化版本测试 ==="
	./main_gpu_optimized

clean:
	rm -f main_cpu main_gpu main_gpu_optimized test_optimized_performance $(INCDIR)/CUDA/*.o

gpu-info:
	@nvidia-smi || echo "NVIDIA GPU不可用"
	@nvcc --version || echo "NVCC编译器不可用"

help:
	@echo "Available targets:"
	@echo "  all              - 编译基础版本 (默认)"
	@echo "  optimized        - 编译Lab5.tex优化版本"
	@echo "  test_performance - 运行优化策略验证测试"
	@echo "  compare_versions - 对比基础版本和优化版本"
	@echo "  clean            - 清理编译产物"
	@echo "  gpu-info         - 显示GPU环境信息"
	@echo "  help             - 显示此帮助信息"

.PHONY: all optimized clean gpu-info help test_performance compare_versions 